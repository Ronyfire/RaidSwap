DATABASE_URL=postgresql://raidswap:raidswap_dev@localhost:5433/raidswap
JWT_SECRET_KEY=

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional — only needed for the WoWAudit roster import (#20). Per-team key,
# not per-user: find it in your team's WoWAudit settings. Without it, the
# paste-roster import still works.
WOWAUDIT_API_KEY=

# Optional — only needed for real spell/creature/class icons via the Blizzard
# Media API. Create a client at https://develop.battle.net/access/clients
# (client-credentials app, no redirect URL needed). Without it, icon
# resolution is skipped.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
